---
// The one page: 18 November 1918 as a feed. Everything on it is rendered at
// build time from src/data/18-11-1918.json — the judged corpus, copied
// verbatim; fix a record upstream, never here.
import data from '../data/18-11-1918.json';
import Head from '../components/Head.astro';
import Post from '../components/Post.astro';
import { plural, refusalReason, trends, type Account, type Post as PostRecord } from '../lib/feed.ts';

// The JSON is the boundary. Shapes are asserted here once and every record
// then passes through refusalReason, which is the closed-set check.
const accounts = data.accounts as Record<string, Account>;
// How many posts are visible before the reader scrolls. Five fills a phone
// screen without filling it twice; raising it only costs the lazy effect,
// never correctness — every post is in the HTML either way.
const EAGER = 5;

const posts = (data.posts as PostRecord[]).slice().sort((a, b) => a.seq - b.seq);

// A refused record is reported at build and never rendered. (The count used
// to print in a footer; the refusal itself is unchanged.)
const shown: PostRecord[] = [];
for (const p of posts) {
  const why = refusalReason(p, accounts[p.handle]);
  if (why) console.error(`ieraksts atteikts: ${p.handle} seq ${p.seq} — ${why}`);
  else shown.push(p);
}
const ranking = trends(shown);

const title = 'dzīvā vēsture — 1918. gada 18. novembris';
const description = 'Diena, kad pasludināja Latviju — kā to rakstīja tajā dienā. Tās dienas avīzes kā plūsma; katrs ieraksts ar avotu periodika.lv.';
---
<!doctype html>
<html lang="lv">
<head>
  {/* The alt must say what public/og.png shows; regenerate both together with tools/og-card.sh. */}
  <Head title={title} description={description} path="" base="" image="og.png"
    imageAlt="dzīvā vēsture, 18. novembris 1918 — Kārļa Ulmaņa ieraksts „Latvijas valstij jābūt demokrātiski taisnai valstij, lai nedotu viņā vietas ne apspiešanai, ne netaisnībai.“" />
</head>
<body>
  <header>
    <div class="wrap top">
      <span class="brand">dzīvā vēsture</span>
      <span class="date">18.11.1918</span>
    </div>
  </header>

  {/* The day is the headline — and, by his choice, the only thing the page
      says about itself: no place line, no standfirst, no note that one day
      exists. The reader-explanation question is parked, not answered here. */}
  <div class="wrap hero">
    <h1>Pirmdiena, 18. novembris 1918</h1>
  </div>

  <nav class="tabs wrap" role="tablist">
    <button type="button" role="tab" data-tab="feed" aria-selected="true" aria-controls="panel-feed">Plūsma</button>
    <button type="button" role="tab" data-tab="trends" aria-selected="false" aria-controls="panel-trends">Kas notiek</button>
  </nav>

  <main class="wrap">
    <div id="panel-feed" role="tabpanel">
      <div id="filterbar" hidden><button type="button" id="chip"></button></div>
      <div id="feed">
        {shown.map((p, i) => (
          <Post post={p} account={accounts[p.handle]} accounts={accounts} gapNote={data.conventions.gap} later={i >= EAGER} />
        ))}
      </div>
      <div id="more" aria-hidden="true"></div>
    </div>

    <div id="panel-trends" role="tabpanel" hidden>
      <div id="trends">
        <div class="k">1918. gada 18. novembrī · pēc tā, cik ierakstu par to raksta</div>
        {ranking.map((t, i) => (
          <button type="button" class="trend" data-topic={t.topic}>
            <span class="scope">{i + 1}. vietā</span>
            <b>{t.topic}</b>
            <span class="n">{t.n} {plural(t.n)}</span>
          </button>
        ))}
      </div>
    </div>
  </main>

  {/* Nothing below the last post — by his choice: no invariant line, no
      conventions, no credit. The guards that produced the invariant still run
      at build (refusalReason above, tests/run.ts, tests/profiles.ts,
      check-18nov-corpus.py); only the display is gone. Attribution for the
      National Library's scans now exists only per item (each „avots →“). */}
</body>
</html>
