---
// The one page: 18 November 1918 as a feed. Everything on it is rendered at
// build time from src/data/18-11-1918.json — the judged corpus, copied
// verbatim; fix a record upstream, never here.
import data from '../data/18-11-1918.json';
import Post from '../components/Post.astro';
import Profile from '../components/Profile.astro';
import { invariantLine, plural, refusalReason, trends, type Account, type Post as PostRecord } from '../lib/feed.ts';
import { GOATCOUNTER_CODE, ORIGIN } from '../lib/site.ts';

// The JSON is the boundary. Shapes are asserted here once and every record
// then passes through refusalReason, which is the closed-set check.
const accounts = data.accounts as Record<string, Account>;
const posts = (data.posts as PostRecord[]).slice().sort((a, b) => a.seq - b.seq);

const shown: PostRecord[] = [];
let refused = 0;
for (const p of posts) {
  const why = refusalReason(p, accounts[p.handle]);
  if (why) { refused++; console.error(`ieraksts atteikts: ${p.handle} seq ${p.seq} — ${why}`); }
  else shown.push(p);
}
const warned = shown.filter((p) => p.warn).length;
const ranking = trends(shown);

const title = 'dzīvā vēsture — 1918. gada 18. novembris';
const description = 'Diena, kad pasludināja Latviju — kā to rakstīja tajā dienā. Tās dienas avīzes kā plūsma; katrs ieraksts ar avotu periodika.lv.';

// Static page: no inline scripts or styles, so every source is 'self'. The
// analytics host is added only when a site code is set.
const gc = GOATCOUNTER_CODE ? ` https://${GOATCOUNTER_CODE}.goatcounter.com` : '';
const csp = [
  "default-src 'none'",
  `script-src 'self'${GOATCOUNTER_CODE ? ' https://gc.zgo.at' : ''}`,
  "style-src 'self'",
  "font-src 'self'",
  `img-src 'self'${gc}`,
  `connect-src 'self'${gc}`,
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---
<!doctype html>
<html lang="lv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${ORIGIN}/`} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${ORIGIN}/`} />
  <meta property="og:locale" content="lv_LV" />
  <meta property="og:site_name" content="dzīvā vēsture" />
  <meta property="og:image" content={`${ORIGIN}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {/* Must say what public/og.png shows; regenerate both together with tools/og-card.sh. */}
  <meta property="og:image:alt" content="dzīvā vēsture — 1918. gada 18. novembris. Kā to rakstīja tajā dienā." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${ORIGIN}/og.png`} />

  {/* All relative: the same build serves from a root, a subdomain or a sub-path. */}
  <link rel="icon" href="favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="fonts/literata-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="fonts/fonts.css" />
  <link rel="stylesheet" href="feed.css" />
  <noscript><link rel="stylesheet" href="nojs.css" /></noscript>
  <script type="module" src="feed.js" is:inline></script>
  {GOATCOUNTER_CODE && (
    <script is:inline async src="https://gc.zgo.at/count.js"
      data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
      data-goatcounter-settings='{"no_onload": true, "allow_frame": false}'></script>
  )}
</head>
<body>
  <header>
    <div class="wrap">
      <div class="masthead">
        <h1>dzīvā <b>vēsture</b></h1>
        <div class="sub">Kā to rakstīja tajā dienā</div>
      </div>
      <div class="day">
        <b>Pirmdiena, 1918. gada 18. novembris</b>
        {data.place} · vācu okupācija
        <span class="one">Pagaidām šeit ir viena diena.</span>
      </div>
    </div>
  </header>

  <nav class="tabs wrap" role="tablist">
    <button type="button" role="tab" data-tab="feed" aria-selected="true" aria-controls="panel-feed">Plūsma</button>
    <button type="button" role="tab" data-tab="trends" aria-selected="false" aria-controls="panel-trends">Kas notiek</button>
  </nav>

  <main class="wrap">
    <div id="panel-feed" role="tabpanel">
      <div id="filterbar" hidden><button type="button" id="chip"></button></div>
      {/* Every claim here is carried by an account bio in the corpus
          (@baltijas_zinas, @lidums) — the page asserts nothing the data does not. */}
      <p class="standfirst">
        <b>18. novembris bija pirmdiena, un no latviešu avīzēm Rīgā tajā rītā iznāca tikai Baltijas Ziņas.</b>{' '}
        Abi lielie latviešu dienas laikraksti tajā dienā neiznāca; svinīgo aktu latviešu prese
        aprakstīs 20. novembra numuros. Zemāk — tas, ko Rīga tajā rītā tiešām lasīja, un tas, ko
        avīzes uzrakstīja pēc tam.
      </p>
      <div id="feed">
        {shown.map((p) => (
          <Post post={p} account={accounts[p.handle]} accounts={accounts} gapNote={data.conventions.gap} />
        ))}
      </div>
    </div>

    <div id="panel-trends" role="tabpanel" hidden>
      <div id="trends">
        <div class="k">1918. gada 18. novembrī · pēc tā, cik ierakstu par to raksta</div>
        {ranking.map((t, i) => (
          <button type="button" class="trend" data-topic={t.topic}>
            <span class="scope">{i + 1}. vietā</span>
            <b>{t.topic}</b>
            <span class="n">{t.n} {plural(t.n)}</span>
          </button>
        ))}
      </div>
    </div>
  </main>

  <footer class="wrap">
    <div class:list={['inv', { bad: refused > 0 }]}>{invariantLine(shown.length, refused, warned)}</div>
    <p>
      Viss teksts ir no digitalizētiem 1918. gada laikrakstiem
      (<a href="https://periodika.lv/">periodika.lv</a>, Latvijas Nacionālā bibliotēka).
      Neviens ieraksts nav sacerēts. Modernizētais pareizrakstības variants ir pārlikums no
      1918. gada ortogrāfijas (vācu avotiem — tulkojums); oriģinālo OCR tekstu var apskatīt
      pie katra ieraksta zem „avots“.
    </p>
    <p>{data.conventions.gap}</p>
    <p>
      Punktēts pasvītrojums zem vārda vai laika nozīmē, ka tas ir lasīts no bojāta OCR vai
      aplēsts; no kā — redzams zem „avots“.
    </p>
  </footer>

  {Object.entries(accounts).map(([handle, a]) => <Profile handle={handle} account={a} />)}
</body>
</html>
