---
// One post card: avatar · name · handle · HH.MM · type badge · text · one thin
// action row. Nothing else on the face. Everything scholarly — the source, the
// raw OCR, the paper's framing, the caveats — is in the HTML but folded.
// A long item is a thread: the first segment is the card, the rest hang off a
// connector below it, collapsed behind „rādīt pavedienu (n)“.
import Segment from './Segment.astro';
import { bodyHtml, initials, TYPE_LABEL, type Account, type Post, type Segment as Seg } from '../lib/feed.ts';

interface Props {
  post: Post;
  account: Account;
  accounts: Record<string, Account>;
  gapNote: string;
}
const { post: p, account, accounts, gapNote } = Astro.props;

const segments: Seg[] = p.thread ?? [{ lv: p.lv, ocr: p.ocr, recon: p.recon, warn: p.warn, ident: p.ident }];
const bodies = segments.map((s) => bodyHtml(s.lv, { recon: s.recon, mentions: p.mentions, ident: s.ident }, accounts, gapNote));
// The paper's framing may carry the same mentions (prototype grammar). A key
// is only "unmatched" if it is printed in no segment and not in the framing.
const context = p.context ? bodyHtml(p.context, { mentions: p.mentions }, accounts, gapNote) : null;
const unmatched = Object.keys(p.mentions ?? {}).filter((k) =>
  bodies.every((b) => b.unmatched.includes(k)) && (!context || context.unmatched.includes(k)));
if (unmatched.length) console.warn(`post ${p.seq}: nav tekstā, netiek rādīts: ${unmatched.join(' · ')}`);
const n = segments.length;
---
<article class="post" id={`p-${p.seq}`} data-topics={p.topics.join('\n')}>
  <div class="who">
    <span class="avatar" aria-hidden="true">{initials(account.name)}</span>
    <div class="meta">
      <button type="button" class="acct" data-handle={p.handle} aria-expanded="false">
        <span class="name">{account.name}</span>
        <span class="handle">{p.handle}</span>
      </button><br />
      {/* A dotted underline means the clock time is an estimate; the title says what bounds it. */}
      <span class:list={['stamp', { derived: !!p.atNote }]} title={p.atNote || undefined}>{p.at}</span>
      <span class={`badge t-${p.type}`}>{TYPE_LABEL[p.type]}</span>
      {n > 1 && <span class="seqno">1/{n}</span>}
    </div>
  </div>

  <div class="body">
    <Segment post={p} segment={segments[0]} html={bodies[0].html} contextHtml={context?.html ?? null} k={0} n={n} />
    {n > 1 && (
      <div class="thread" id={`t-${p.seq}`} hidden>
        {segments.slice(1).map((s, i) => (
          <Segment post={p} segment={s} html={bodies[i + 1].html} contextHtml={null} k={i + 1} n={n} />
        ))}
      </div>
    )}
  </div>
</article>
