---
// One post: avatar · name · handle · HH.MM · the words · one thin action row.
// Nothing else on the face — no type badge, no notes: it must read as a feed
// first and as 1918 only through the words. Everything scholarly — the type,
// the source, the raw OCR, the paper's framing, the caveats — is in the HTML
// but folded under „avots“. A long item is a thread: the first segment is the post, the rest
// hang below it, collapsed behind „rādīt pavedienu (n)“.
import Segment from './Segment.astro';
import { avatarHue, bodyHtml, initials, profilePath, reportedBy, type Account, type Post, type Segment as Seg } from '../lib/feed.ts';

interface Props {
  post: Post;
  account: Account;
  accounts: Record<string, Account>;
  gapNote: string;
  base?: string;  // relative path to the site root from the page rendering this post
}
const { post: p, account, accounts, gapNote, base = '' } = Astro.props;

const segments: Seg[] = p.thread ?? [{ lv: p.lv, ocr: p.ocr, recon: p.recon, warn: p.warn, ident: p.ident }];
const bodies = segments.map((s) => bodyHtml(s.lv, { recon: s.recon, mentions: p.mentions, ident: s.ident }, accounts, gapNote, base));
// The paper's framing may carry the same mentions (prototype grammar). A key
// is only "unmatched" if it is printed in no segment and not in the framing.
const context = p.context ? bodyHtml(p.context, { mentions: p.mentions }, accounts, gapNote, base) : null;
const unmatched = Object.keys(p.mentions ?? {}).filter((k) =>
  bodies.every((b) => b.unmatched.includes(k)) && (!context || context.unmatched.includes(k)));
if (unmatched.length) console.warn(`post ${p.seq}: nav tekstā, netiek rādīts: ${unmatched.join(' · ')}`);
const n = segments.length;
// A person's words as a paper rendered them: said in language on the face.
const reporter = account.kind === 'person' && p.type === 'atstastits' ? reportedBy(p.via) : null;
---
<article class="post" id={`p-${p.seq}`} data-topics={p.topics.join('\n')}>
  <div class="who">
    {/* Circle for a person, rounded square for a paper or an office; one hue per
        account. The name beside it is the link to the account's page. */}
    <span class={`avatar k-${account.kind} h-${avatarHue(p.handle)}`} aria-hidden="true">{initials(account.name)}</span>
    <div class="meta">
      <a class="acct" href={profilePath(p.handle, base)}>
        <span class="name">{account.name}</span>
        <span class="handle">{p.handle}</span>
      </a>
      {/* The clock time is an estimate for nearly every post; the fold says what bounds it. */}
      <span class="stamp" title={p.atNote || undefined}>{p.at}</span>
      {n > 1 && <span class="seqno"> · 1/{n}</span>}
    </div>
  </div>

  <div class="body">
    {reporter && <p class="reporter">kā ziņo {reporter}</p>}
    <Segment post={p} segment={segments[0]} html={bodies[0].html} contextHtml={context?.html ?? null} k={0} n={n} />
    {n > 1 && (
      <div class="thread" id={`t-${p.seq}`} hidden>
        {segments.slice(1).map((s, i) => (
          <Segment post={p} segment={s} html={bodies[i + 1].html} contextHtml={null} k={i + 1} n={n} />
        ))}
      </div>
    )}
  </div>
</article>
