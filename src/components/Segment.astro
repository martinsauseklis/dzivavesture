---
// One segment of a post: its text and its thin action row. A plain post is
// one segment; a thread is several, and only the first (k = 0) carries the
// replies. „avots“ is a plain link to the article on periodika.lv and nothing
// else. The record's later / warn / context / ocr / recon / ident notes are
// not rendered as a panel any more — by his choice; the data keeps them. What
// remains of them on the face is the inline markers, each explaining itself
// in a title attribute.
import { recollectionLine, type Post, type Segment } from '../lib/feed.ts';

interface Props {
  post: Post;
  segment: Segment;
  html: string;
  k: number;
  n: number;
  share?: string;  // the X intent link — first segment only; the fragment addresses the post
}
const { post: p, html, k, n, share } = Astro.props;
const id = (kind: string) => (k ? `${kind}-${p.seq}-${k + 1}` : `${kind}-${p.seq}`);
const replies = p.comments?.length ?? 0;
// A recollection written years later: the writing year is the one thing on
// the face a reader cannot infer from the account, so it is the one line in
// the accent — on EVERY segment, because a reader three segments into a
// chapter has settled into reading and must still know when the words were
// written. The clock time stays the moment described, in 1918.
const written = recollectionLine(p);
---
<div class="seg">
  {k > 0 && <div class="seghead">{p.handle} · <b>{k + 1}/{n}</b></div>}
  {written && <p class="written" title={`${p.at} ir notikuma laiks; teksts rakstīts ${p.written}. gadā`}>{written}</p>}
  <p class="lv" set:html={html} />

  {/* The rest of the thread, replies; at the right, share and the source link —
      what a feed's row holds, in the site's words. */}
  <div class="bar">
    {k === 0 && n > 1 && (
      <button type="button" class="thread-toggle" aria-controls={id('t')} aria-expanded="false">rādīt pavedienu ({n})</button>
    )}
    {k === 0 && p.comments && (
      <button type="button" aria-controls={id('c')} aria-expanded="false">atbildes · {replies}</button>
    )}
    {share && <a class="share" href={share} target="_blank" rel="noopener">dalīties</a>}
    <a class="src-link" href={p.url} target="_blank" rel="noopener">avots →</a>
  </div>

  {k === 0 && p.comments && (
    <div class="fold comments" id={id('c')} data-kind="comments" hidden>
      <div class="k">Saruna pie raksta</div>
      {p.comments.map((c) => (
        <div class="cmt">
          <b>{c.name}</b> <span class="chandle">{c.handle}</span><br />
          {c.text}
          <span class="cvia">{c.via} · <a href={c.url} target="_blank" rel="noopener">skenējums →</a></span>
        </div>
      ))}
    </div>
  )}

</div>
