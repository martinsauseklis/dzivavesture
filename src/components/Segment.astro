---
// One segment of a post: its text, its thin action row and its folded
// apparatus. A plain post is one segment; a thread is several, and only the
// first (k = 0) carries the item-level things — replies, „Kā tas beidzās“,
// the paper's framing, the time note.
import type { Post, Segment } from '../lib/feed.ts';

interface Props {
  post: Post;
  segment: Segment;
  html: string;
  contextHtml: string | null;
  k: number;
  n: number;
}
const { post: p, segment: s, html, contextHtml, k, n } = Astro.props;
const id = (kind: string) => (k ? `${kind}-${p.seq}-${k + 1}` : `${kind}-${p.seq}`);
const replies = p.comments?.length ?? 0;
---
<div class="seg">
  {k > 0 && <div class="seghead">{p.handle} · <b>{k + 1}/{n}</b></div>}
  <p class="lv" set:html={html} />

  <div class="bar">
    {k === 0 && p.comments && (
      <button type="button" aria-controls={id('c')} aria-expanded="false">atbildes · {replies}</button>
    )}
    {k === 0 && p.later && (
      <button type="button" aria-controls={id('l')} aria-expanded="false">Kā tas beidzās →</button>
    )}
    {/* The ⚠ is the only trace a caveat leaves on the face: folded, not invisible. */}
    <button type="button" aria-controls={id('s')} aria-expanded="false" aria-label={s.warn ? 'avots, ar piezīmi' : 'avots'}>
      avots{s.warn && ' ⚠'}
    </button>
    {k === 0 && n > 1 && (
      <button type="button" class="thread-toggle" aria-controls={id('t')} aria-expanded="false">rādīt pavedienu ({n})</button>
    )}
  </div>

  {k === 0 && p.comments && (
    <div class="fold comments" id={id('c')} data-kind="comments" hidden>
      <div class="k">Zem raksta</div>
      {p.comments.map((c) => (
        <div class="cmt">
          <b>{c.name}</b> <span class="chandle">{c.handle}</span><br />
          {c.text}
          <span class="cvia">{c.via} · <a href={c.url} target="_blank" rel="noopener">skenējums →</a></span>
        </div>
      ))}
    </div>
  )}

  {k === 0 && p.later && (
    <div class="fold later" id={id('l')} data-kind="later" hidden>
      <div class="k">Kā tas beidzās</div>
      {p.later}
    </div>
  )}

  <div class="fold src" id={id('s')} data-kind="src" hidden>
    {k === 0 && contextHtml && (
      <div class="context"><div class="k">Kā to ierāmēja laikraksts</div><Fragment set:html={contextHtml} /></div>
    )}
    {s.warn && <p class="warn">⚠ {s.warn}</p>}
    {/* Tooltips do not open on a phone, so the same notes are repeated here. */}
    {k === 0 && p.atNote && <p class="via">Laiks {p.at} — {p.atNote}</p>}
    {s.recon && (
      <p class="via">Rekonstruēts no OCR: {Object.entries(s.recon).map(([word, raw], i) => (
        <>{i > 0 && ' · '}<i>{word}</i> ← „{raw}“</>
      ))}</p>
    )}
    {s.ident && s.ident.map((i) => (
      <p class="via ident-note">
        <b>Identificēts:</b> „{i.rendered}“ ← OCR „{i.ocr}“ ·
        <b>pierādījums:</b> {i.evidence === 'glyphs' ? 'burtu atbilstība' : 'dokumentārs apliecinājums'} ·
        <b>avots:</b> {i.candidate_source}
        {i.corroboration && <> · <b>apliecina:</b> {i.corroboration}</>} ·
        <b>burtu atbilstība:</b> {i.glyph_match}
      </p>
    ))}
    <p class="via">{p.via}{n > 1 && ` · pavediena ${k + 1}. daļa`} · <a href={p.url} target="_blank" rel="noopener">skenējums →</a></p>
    {s.ocr ? <pre class="ocr">{s.ocr}</pre> : <p class="via">OCR teksta nav.</p>}
  </div>
</div>
